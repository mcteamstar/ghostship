#!/usr/bin/env python3
"""Gate-safe gateway operations for named KiroCrew persona tasks."""

from __future__ import annotations

import json
import os
import re
import sys
from pathlib import Path
from urllib import error, request

_BASE_URL = "http://localhost:5476"
_COOKIE_PATH = Path("/home/kirocrew/.kiro/crew/.dashboard_cookie")
_COOKIE_NAME = "mc_token_5476"
_DEFAULT_ORIGIN = _BASE_URL
_PERSONA_RE = re.compile(r"^[a-z][a-z0-9-]{0,31}$")
_TASK_ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
# RFC 6265 cookie-octet, bounded so malformed input cannot become a header
# injection or be echoed through a library exception.
_COOKIE_VALUE_RE = re.compile(
    r"^[\x21\x23-\x2B\x2D-\x3A\x3C-\x5B\x5D-\x7E]{1,4096}$"
)


class SpawnError(Exception):
    """A user-facing helper failure."""


class _NoRedirect(request.HTTPRedirectHandler):
    """Keep the fixed-destination guarantee across gateway responses."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _usage_error() -> SpawnError:
    return SpawnError(
        "usage: ghostship-spawn <persona> | --status <task_id> | "
        "--steer <task_id> | --continue <task_id>"
    )


def _parse_args(argv: list[str]) -> tuple[str, str | None, str | None]:
    """Return ``(operation, value, path)`` after validating argv."""
    if len(argv) == 1 and not argv[0].startswith("-"):
        persona = argv[0]
        if not _PERSONA_RE.fullmatch(persona):
            raise SpawnError("invalid persona")
        return "dispatch", persona, "/api/spawn"

    if len(argv) == 2 and argv[0] in {"--status", "--steer", "--continue"}:
        task_id = argv[1]
        if not _TASK_ID_RE.fullmatch(task_id):
            raise SpawnError("invalid task id")
        suffix = {
            "--status": "",
            "--steer": "/steer",
            "--continue": "/continue",
        }[argv[0]]
        operation = {
            "--status": "status",
            "--steer": "steer",
            "--continue": "continue",
        }[argv[0]]
        return operation, task_id, f"/api/spawn/{task_id}{suffix}"

    raise _usage_error()


def _read_task_text() -> str:
    text = sys.stdin.read()
    if not text.strip():
        raise SpawnError("task text must not be empty")
    return text


def _read_cookie() -> str:
    try:
        cookie = _COOKIE_PATH.read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise SpawnError("could not read dashboard cookie") from exc
    if not cookie:
        raise SpawnError("dashboard cookie is empty")
    if not _COOKIE_VALUE_RE.fullmatch(cookie):
        raise SpawnError("dashboard cookie has invalid format")
    return cookie


def _origin() -> str:
    configured = os.environ.get("KIROCREW_CORS_ORIGINS", "")
    return configured.split(",", 1)[0].strip() or _DEFAULT_ORIGIN


def _redact(text: str, cookie: str) -> str:
    """Ensure an untrusted gateway response cannot echo the session cookie."""
    return text.replace(cookie, "[redacted]") if cookie else text


def _response_text(body: bytes, cookie: str) -> str:
    return _redact(body.decode("utf-8", errors="replace"), cookie)


def _request_gateway(
    operation: str,
    method: str,
    path: str,
    payload: dict[str, object] | None,
    cookie: str,
) -> str:
    data = None
    headers = {
        "Accept": "application/json",
        "Cookie": f"{_COOKIE_NAME}={cookie}",
        "Origin": _origin(),
    }
    if payload is not None:
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        headers["Content-Type"] = "application/json"

    # The base URL and path are constants/validated values. Disable redirects
    # as well: following a gateway-supplied Location could send the cookie or
    # request body away from the crew's own loopback gateway.
    req = request.Request(
        f"{_BASE_URL}{path}",
        data=data,
        headers=headers,
        method=method,
    )
    try:
        opener = request.build_opener(request.ProxyHandler({}), _NoRedirect())
        with opener.open(req, timeout=30) as response:
            status = getattr(response, "status", None)
            if status is None:
                status = response.getcode()
            body = response.read()
    except error.HTTPError as exc:
        try:
            body = exc.read()
        except OSError:
            body = b""
        detail = _response_text(body, cookie)
        raise SpawnError(f"{operation} failed: HTTP {exc.code}: {detail}") from exc
    except (error.URLError, OSError) as exc:
        detail = _redact(str(exc), cookie)
        raise SpawnError(f"{operation} failed: {detail}") from exc
    except Exception as exc:
        detail = _redact(str(exc), cookie)
        raise SpawnError(f"{operation} failed: {detail}") from exc

    detail = _response_text(body, cookie)
    if not 200 <= status < 300:
        raise SpawnError(f"{operation} failed: HTTP {status}: {detail}")
    return detail


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    try:
        operation, value, path = _parse_args(argv)
        payload: dict[str, object] | None
        if operation == "dispatch":
            # Keep named-persona runs retained so status/steer/continue and
            # the SDD follow-up protocol work after the initial turn.
            payload = {"task": _read_task_text(), "agent": value or "", "keep": True}
            method = "POST"
        elif operation == "status":
            payload = None
            method = "GET"
        elif operation == "steer":
            payload = {"message": _read_task_text()}
            method = "POST"
        else:
            payload = {"task": _read_task_text()}
            method = "POST"
        cookie = _read_cookie()
        output = _request_gateway(operation, method, path or "", payload, cookie)
    except SpawnError as exc:
        print("ghostship-spawn: " + " ".join(str(exc).splitlines()), file=sys.stderr)
        return 1

    sys.stdout.write(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
