# ghostship.conf.example — copy to ghostship.conf and fill in your values
# Pass to install.sh with: ./install.sh --config ghostship.conf
# Every value below is commented out and shows install.sh's actual built-in
# default (kept in sync with the literal defaults block at the top of
# install.sh) — uncomment and edit only the ones you want to override.
# Full reference: docs/configuration.md

# ── Network ───────────────────────────────────────────────────────────────────
# Port the transport listens on (MCP + file transfer on the same port).
# PORT=64057

# Interface the transport binds inside the container. Default 0.0.0.0 binds all
# interfaces; host-side install.sh publishes to 127.0.0.1 only. Set to 127.0.0.1
# for loopback-only binding on non-containerised installs.
# HOST=0.0.0.0

# Public URL baked into presigned evac/supply links.
# For local installs, leave unset (defaults to http://localhost:<PORT>).
# For remote installs, set to the publicly reachable address.
# GA_HOST_URL=""

# ── Authentication ────────────────────────────────────────────────────────────
# API key for MCP endpoint auth. Leave unset for local/trusted installs.
# GA_API_KEY=""

# kiro-cli identity provider (omit to use default Builder ID / free tier).
# KIRO_IDENTITY_PROVIDER=""
# KIRO_REGION=""
# KIRO_LICENSE=""

# Two auth paths for kiro-cli inside crews:
#   Option A — API key (Pro+, headless): set KIRO_API_KEY to skip the device-code
#     login flow entirely. The key is injected as an env var into crew containers
#     and kiro-cli authenticates directly — no POST /login, no browser step.
#     Re-run install.sh after setting this so the transport picks it up.
#   Option B — Device code (default, all tiers): leave KIRO_API_KEY unset. After
#     install, run POST /login once to complete the browser-based auth flow. For
#     org (IAM Identity Center) licensing, also set the KIRO_IDENTITY_PROVIDER /
#     KIRO_REGION / KIRO_LICENSE vars above.
# KIRO_API_KEY=""

# ── Model ─────────────────────────────────────────────────────────────────────
# Override the default model for all crew agents.
# KC_MODEL_OVERRIDE=""

# Set a global model fallback for agents that don't have a per-agent model set.
# Lower precedence than KC_MODEL_OVERRIDE and per-agent model fields.
# Precedence: KC_MODEL_OVERRIDE > per-agent model > KC_MODEL_DEFAULT > KiroCrew built-in
# KC_MODEL_DEFAULT=""

# ── Dedicated Podman Machine ──────────────────────────────────────────────────
# Provision an isolated Podman machine (macOS) or instance (Linux) exclusively
# for Ghost Academy crew containers. Keeps GA containers off your default
# Podman runtime — no contention, no accidental interference from IDE plugins
# or other tooling. Default: enabled, named "ghost-academy".
# GA_DEDICATED_MACHINE=true

# macOS only — resources allocated to the dedicated VM:
# GA_MACHINE_CPUS=8
# GA_MACHINE_MEMORY=16384
# GA_MACHINE_DISK=100

# Name of the dedicated machine/service:
# GA_MACHINE_NAME="ghost-academy"

# ── Crew lifecycle ────────────────────────────────────────────────────────────
# Stop idle crew containers after this many seconds to free memory.
# The schedule monitor wakes crews before ticks fire, so this can be set
# independently of any captain interval.
# GA_IDLE_TIMEOUT_SECS=300

# Maximum number of registered crews (running + stopped).
# Stopped crews cost no memory, so this is a housekeeping limit.
# GA_MAX_CREWS=20

# Maximum number of simultaneously running crew containers.
# Enforced on restart: refused if running count already equals this limit.
# Set to 0 to disable the active limit entirely.
# GA_MAX_ACTIVE_CREWS=3

# ── Subagent timeouts ─────────────────────────────────────────────────────────
# Wall-clock timeout per task (seconds). KiroCrew default is 1800 (30 min).
# GA_SUBAGENT_TIMEOUT_SECS=3600

# Maximum turns per task. KiroCrew default is 100.
# GA_SUBAGENT_MAX_TURNS=200

# ── Memory gate ───────────────────────────────────────────────────────────────
# Minimum free host memory (GB) required before launching a new crew.
# Set to 0 to disable the gate entirely.
# GA_MIN_FREE_MEM_GB=2.0

# How long to wait (seconds) for memory to free up before failing the launch.
# GA_MEMORY_WAIT_SECS=60

# ── KiroCrew memory thresholds ────────────────────────────────────────────────
# Written to config.local.json inside each crew at launch.
# GA_SPAWN_MIN_MEMORY_GB=1.5
# GA_RESOURCE_PRESSURE_GB=2.0
# GA_RESOURCE_CRITICAL_GB=1.0

# ── Storage / runtime paths ───────────────────────────────────────────────────
# Directory the transport uses for its persistent state (crews.json, secrets).
# Inside the container this is the /data mount; rarely overridden.
# TRANSPORT_DATA_DIR=/data

# Path to the Podman API socket the transport talks to.
# PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# ── Container images ──────────────────────────────────────────────────────────
# Crew container image used for spec-ops crews.
# KC_IMAGE=localhost/spec-ops:latest

# Upstream base image used for ephemeral kiro-cli-only containers (e.g. login).
# KC_BASE_IMAGE=ghcr.io/kirodotdev/kirocrew:0.4.0

# ── Crew agent ────────────────────────────────────────────────────────────────
# KiroCrew agent name written to config.local.json inside each crew. Must be
# non-empty (KiroCrew 0.4.0 requires it). Override for a differently-named agent.
# GA_CREW_AGENT=kiro

# ── File transfer ─────────────────────────────────────────────────────────────
# TTL (seconds) for presigned evac/supply file URLs.
# GA_FILE_TTL_SECS=300

# Max seconds to poll for a pickup file to appear before giving up.
# GA_PICKUP_MAX_POLL_SECS=30

# ── Gateway ───────────────────────────────────────────────────────────────────
# TTL for the KiroCrew gateway token minted for each crew.
# Accepted format: <N>[s|m|h|d] where N is a positive integer, e.g. 24h, 3600s, 7d, 30m.
# Invalid values are rejected at startup with a WARNING; the default 24h is used instead.
# KC_GATEWAY_TOKEN_TTL=24h

# ── Transport TLS / security headers (TRN-70) ─────────────────────────────────
# Minimum TLS version enforced when the app terminates TLS directly ("1.2"/"1.3").
# GA_TLS_MIN_VERSION=1.2

# Enable direct TLS termination by pointing these at a cert/key pair.
# GA_TLS_CERTFILE=""
# GA_TLS_KEYFILE=""

# Emit baseline security headers (HSTS, etc.). Default on.
# GA_ENABLE_SECURITY_HEADERS=1

# 301-redirect plaintext HTTP to HTTPS. Staged rollout; default off.
# GA_ENFORCE_HTTPS_REDIRECT=0

# Send CSP as enforcing rather than report-only. Staged rollout; default off.
# GA_CSP_ENFORCE=0

# ── HTTP rate limiting (TRN-52) ───────────────────────────────────────────────
# Per-endpoint sliding-window request limits. Each value is "<count>:<window_secs>"
# (both positive integers). State is in-memory only and resets on transport restart.
# Master switch — set to "false" to disable all rate limiting entirely.
# GA_RATE_LIMIT_ENABLED=true
# GET /login — polling allowed, hammering blocked (default 30 req / 60 s).
# GA_RATE_LIMIT_LOGIN_GET=30:60
# POST /login — tight limit enforces deliberate use (default 5 req / 300 s).
# GA_RATE_LIMIT_LOGIN_POST=5:300
# /mcp and sub-paths — headroom for multi-tool orchestration (default 300 req / 60 s).
# GA_RATE_LIMIT_MCP=300:60
# /files/* — protects git subprocess execution (default 60 req / 60 s).
# GA_RATE_LIMIT_FILES=60:60
# /crews/*/api/* — proxied crew API (default 120 req / 60 s).
# GA_RATE_LIMIT_CREW_API=120:60

# ── Git author identity ───────────────────────────────────────────────────────
# When both vars are set, all crew commits carry the operator's identity as
# both author and committer. Unset → per-persona identity is used (default).
# Note: this applies to ALL agents — Ghost, Banshee, etc. will all commit as
# the configured operator. Leave unset to keep per-persona differentiation.
# GA_GIT_AUTHOR_NAME="Your Name"
# GA_GIT_AUTHOR_EMAIL="you@example.com"

# ── Crew UI port allocation (TRN-80 / TRN-101) ───────────────────────────────
# Each crew launched with dashboard=True is assigned a host port from the range
# [GA_DASHBOARD_PORT_RANGE_START, GA_DASHBOARD_PORT_RANGE_START + GA_DASHBOARD_PORT_RANGE_SIZE - 1].
# Open the port range in your firewall before deploying (e.g. ufw allow 64058:64107/tcp).
# Dashboard ports are opt-in at launch time (dashboard=True).
#
# TRN-101/TRN-103 MIGRATION: GA_DASHBOARD_PORT_ENABLED was removed. Dashboard
# access is now provided by ga-portal (Caddy), which is always installed. If you
# previously used GA_DASHBOARD_PORT_ENABLED=true, just re-run install.sh — the
# portal replaces the per-port proxy. See docs/dashboard-proxy.md.
#
# GA_DASHBOARD_PORT_RANGE_START=64058
# GA_DASHBOARD_PORT_RANGE_SIZE=50

# ── Caddy reverse proxy (TRN-92 / TRN-103) ───────────────────────────────────
# ga-portal (Caddy) is a required component and is always installed. It binds
# ports 443/80 AND the dashboard port range, terminates TLS, and gates auth for
# all dashboard ports; the transport's per-port uvicorn listeners are not
# started. See docs/caddy.md for full setup and the vm23 host-Caddy retirement
# note.
#
# TRN-103 MIGRATION: GA_PORTAL_ENABLED was removed — there is no opt-out. Any
# deployment that previously set GA_PORTAL_ENABLED=false must re-run install.sh
# to regenerate compose.yml. The GA_PORTAL_* vars below still configure how the
# portal behaves.

# URL of the Caddy admin API (reachable from ga-transport over ga-portside).
# Override only when running Caddy on a non-standard address.
# GA_PORTAL_ADMIN_URL=http://ga-portal:2019

# TLS mode. Choose one that fits your environment:
#
#   internal (default) — Caddy built-in CA issues self-signed certs. Works
#     on localhost, private IPs, and Tailscale addresses without DNS.
#     One-time operator trust step required: install.sh prints the exact command.
#     Ideal for homelab and private-network deployments.
#
#   tailscale — Real browser-trusted certs from Tailscale ACME for .ts.net
#     hostnames. Requires the Tailscale daemon on the host. No trust step.
#     Ideal for vm23/academy deployments.
#
#   acme — Public Let's Encrypt certificate for GA_PORTAL_DOMAIN. Requires
#     GA_PORTAL_DOMAIN set and ports 80/443 reachable for ACME challenge.
#     Ideal for internet-facing deployments.
#
#   off — Plain HTTP, no TLS. For local dev or when an upstream terminator
#     already handles TLS.
#
# GA_PORTAL_TLS_MODE=off   ← default: plain HTTP

# Domain for ACME (Let's Encrypt). Required when GA_PORTAL_TLS_MODE=acme.
# GA_PORTAL_DOMAIN=""

# Port Caddy listens on. Works for both HTTP and HTTPS — TLS mode is independent
# of port choice. Default 64057 matches the old direct-transport endpoint so
# existing MCP client configs work without changes.
# GA_PORTAL_PORT=64057

# TTL (seconds) for gs_session cookies issued by /dashboard-login.
# Default 86400 (24 h). Sessions are in-memory only and reset on transport restart.
# GA_PORTAL_SESSION_TTL_SECS=86400

# TRN-107: GA_TRANSPORT_SECRET is auto-generated by install.sh and stored as a
# Podman secret (ga-transport-secret). It is NOT configured here — install.sh
# handles generation (idempotent: preserved across reinstalls). The value is
# injected into both ga-transport and ga-portal at container start time via
# the Podman secrets mechanism. To rotate the secret, delete the Podman secret
# and re-run install.sh: podman secret rm ga-transport-secret && ./scripts/install.sh
# GA_TRANSPORT_SECRET=""