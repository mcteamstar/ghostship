# ghostship.yaml.example — copy to config/ghostship.yaml and edit the keys you
# want to override. Every value below is commented out and shows the built-in
# default. Config is an OVERRIDE file — only uncomment keys you want to change.
#
# Resolution (deep merge, later wins at the individual key level):
#   1. built-in defaults
#   2. config/ghostship.yaml            (this file, when present)
#   3. XDG override                     (per-OS, see docs/configuration.md)
# Passing `./install.sh --config <path>` replaces layers 2 and 3 entirely:
# that file merges on top of built-in defaults only.
#
# Full reference: docs/configuration.md

# ── network ───────────────────────────────────────────────────────────────────
# network:
#   # Bind address for the transport uvicorn server. Inside the container this
#   # should stay at the default (all interfaces).
#   host: "0.0.0.0"
#   # Port the transport (and ga-portal / Caddy) listen on.
#   port: 64057
#   # Public URL baked into presigned evac/supply links. Leave unset for local
#   # installs (defaults to http://localhost:<port>); set for remote installs.
#   host_url: ""
#   # API key for MCP endpoint auth. Leave unset for local/trusted installs.
#   api_key: ""
#   # Bind-address enforcement when api_key is unset and host is non-loopback:
#   # error (default, abort/refuse) | warn | off.
#   require_api_key: "error"
#   # Direct TLS termination: point both at a cert/key pair in the same dir.
#   # Both must be set together or both left unset.
#   tls_certfile: ""
#   tls_keyfile: ""

# ── crew ───────────────────────────────────────────────────────────────────────
# crew:
#   # Maximum number of registered crews (running + stopped). Housekeeping limit.
#   max_crews: 20
#   # Maximum simultaneously running crew containers. 0 (or ≤ 0) disables it.
#   max_active: 3
#   # Stop idle crew containers after this many seconds to free memory.
#   idle_timeout_secs: 300
#   # Wall-clock timeout per subagent task (seconds).
#   subagent_timeout_secs: 3600
#   # Max tool-call turns per subagent task.
#   subagent_max_turns: 200
#   # Max tasks accepted in a single batch dispatch.
#   batch_max_tasks: 20
#   # Max seconds a pickup poll waits.
#   pickup_max_poll_secs: 30
#   # Absolute path to a host dir of operator standing-order templates. When set
#   # and present, merged with built-in academy/orders/ (operator wins on name
#   # collision). Bind-mounted read-only at /mnt/orders.
#   orders_dir: ""
#   # When both are set, all crew commits carry this identity as author AND
#   # committer. Unset → per-persona identity is used.
#   git_author_name: ""
#   git_author_email: ""
#   memory:
#     # Minimum free host memory (GB) required before launching a crew. 0 = off.
#     min_free_mem_gb: 2.0
#     # Minimum free memory (GB) before accepting a new subagent spawn.
#     spawn_min_memory_gb: 1.5
#     # Memory (GB) below which the host reports "tight" pressure.
#     resource_pressure_gb: 2.0
#     # Memory (GB) below which the host reports "critical" pressure.
#     resource_critical_gb: 1.0
#     # Consecutive pressure cycles before the transport mails the Admiral.
#     spawn_pressure_escalate_cycles: 3

# ── model ──────────────────────────────────────────────────────────────────────
# model:
#   # Override the model for all crew agents.
#   override: ""
#   # Global model fallback for agents with no per-agent model set. Precedence:
#   # dispatch(model=...) > model.override > per-agent model > model.default > built-in.
#   default: ""

# ── backends ─────────────────────────────────────────────────────────────────
# backends:
#   # Which agent backend(s) to build and run. Comma-separated for
#   # multi-toolchain builds; first entry is the runtime default. kiro is always
#   # bundled. Values: kiro (default), claude, codex.
#   agent: "kiro"
#   kiro:
#     # kiro-cli identity provider URL (omit for Builder ID / free tier).
#     identity_provider: ""
#     region: ""
#     license: ""
#   claude:
#     # Optional non-secret Anthropic-compatible base URL (e.g. a local proxy).
#     # Credentials are NOT set here — run `ghostship auth login claude`.
#     base_url: ""
#   codex:
#     # Optional OpenAI-compatible base URL (blank = https://api.openai.com/v1).
#     # Credentials are NOT set here — run `ghostship auth login codex`.
#     base_url: ""

# ── portal (ga-portal / Caddy reverse proxy) ───────────────────────────────────
# portal:
#   # TLS mode: internal | tailscale | acme | off (default).
#   tls_mode: "off"
#   # Domain for ACME (Let's Encrypt). Required when tls_mode: acme.
#   domain: ""
#   # TTL (seconds) for gs_session cookies issued by /dashboard/login.
#   session_ttl_secs: 86400
#   # Crew dashboard host-port allocation range.
#   dashboard_port_range_start: 64058
#   dashboard_port_range_size: 64
#   # Allocate a dashboard on every launch() when true.
#   dashboard_default: false
#   rate_limit:
#     # Master switch — false disables all HTTP rate limiting.
#     enabled: true
#     # Per-endpoint "requests:window_seconds" limits.
#     login_get: "30:60"
#     login_post: "5:300"
#     mcp: "300:60"
#     files: "60:60"
#     crew_api: "120:60"
#     dashboard_auth: "600:60"

# ── machine (dedicated Podman machine/instance) ────────────────────────────────
# machine:
#   # Provision an isolated Podman machine (macOS) / instance (Linux) exclusively
#   # for crew containers. Default: enabled, named "ghost-academy".
#   dedicated: true
#   name: "ghost-academy"
#   # macOS only — resources allocated to the dedicated VM.
#   cpus: 8
#   memory: 16384
#   disk: 100

# ── images (advanced / expert-only) ────────────────────────────────────────────
# Normal installs never need to override these. See docs/configuration.md.
# images:
#   podman_socket: "/run/user/1000/podman/podman.sock"
#   kc_image: "localhost/spec-ops:latest"
#   # Pinned by install.sh when empty; override only to test a specific base.
#   kc_base_image: ""
