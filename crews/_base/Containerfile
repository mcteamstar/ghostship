# Base crew image — shared infrastructure that every composition inherits.
# Contains: mailutils/msmtp, Maildir provisioning, local mail delivery,
# Admiral signature verification, and kiro-cli DB pre-seed.
#
# This is a build dependency, not a launchable composition — it is NOT
# listed in crews/registry.json.
#
# Pinned to 0.3.0 semver tag — deterministic, conventionally stable.
# When upstream releases 0.4.0, update this line and run install.sh to rebuild.
FROM ghcr.io/kirodotdev/kirocrew:0.3.0

# Extend the official KiroCrew image with extra tooling for crew containers.
# Built locally at install time — not pushed to any registry.
# Add packages here as needed; keep it lean.
USER root

# ghostship-mail: proper local mail delivery via mailutils + msmtp-mta + procmail
# Replaces hand-rolled mbox file-append. Local delivery only — no external SMTP.
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
      mailutils msmtp msmtp-mta && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Provision Maildir mailboxes for all 7 local addresses
# (6 personas + captain; admiral is written by the transport only)
# Owned by kirocrew so agents can deliver without root or mail group.
RUN for mb in ghost spectre banshee wraith reaper raven captain; do \
      install -d -o kirocrew -g kirocrew -m 700 \
        /var/mail/$mb \
        /var/mail/$mb/new \
        /var/mail/$mb/cur \
        /var/mail/$mb/tmp; \
    done && chmod 1777 /var/mail

# Local mail delivery configuration
COPY --chown=root:root msmtprc /etc/msmtprc
COPY --chown=root:root maildeliver /usr/local/bin/maildeliver
COPY --chown=root:root sendmail-local /usr/local/bin/sendmail-local
RUN chmod 644 /etc/msmtprc && chmod 755 /usr/local/bin/maildeliver && \
    chmod 755 /usr/local/bin/sendmail-local && \
    ln -sf /usr/local/bin/sendmail-local /usr/sbin/sendmail

# HMAC verification helper for Admiral mail authenticity
COPY --chown=root:root verify-admiral-sig /usr/local/bin/verify-admiral-sig
RUN chmod 755 /usr/local/bin/verify-admiral-sig

# Pre-seed the kiro-cli SQLite DB with schema + all migrations applied.
# At launch, transport only needs to INSERT auth_kv rows — no migration wait,
# no restart needed.
#
# ⚠️  FRAGILITY WARNING — read before updating kirocrew:
# This schema and migration count (10 rows, versions 0–9) was extracted from
# kiro-cli as shipped with kirocrew 0.2.0. If kiro-cli adds new migrations in a
# future kirocrew release, this pre-seeded DB will be missing them and kiro-cli
# may fail to start or behave incorrectly in crew containers.
#
# When updating the FROM ghcr.io/kirodotdev/kirocrew pin to a newer version:
#   1. Spin up a crew with the old image, run launch normally
#   2. In the running container: python3 -c "import sqlite3; conn=sqlite3.connect(
#      '/home/kirocrew/.local/share/kiro-cli/data.sqlite3');
#      print(conn.execute('SELECT COUNT(*), MAX(version) FROM migrations').fetchone())"
#   3. If count or max version changed, update seed_kiro_db.py below to match
#   4. If schema changed, update the CREATE TABLE statements in seed_kiro_db.py too
#
# Tracked in: README.md — "Extending the crew image"
COPY --chown=kirocrew:kirocrew seed_kiro_db.py /tmp/seed_kiro_db.py
USER kirocrew
RUN python3 /tmp/seed_kiro_db.py && rm /tmp/seed_kiro_db.py
