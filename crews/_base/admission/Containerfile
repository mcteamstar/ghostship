# Induction layer: shared infrastructure installed as root.
#
# Every composition inherits from this image. It ends as USER root so
# compositions can add their own root-level installs without a USER switch.
# The graduation layer (_base-graduation) is applied after the composition
# to restore USER kirocrew and run any kirocrew-owned setup.
#
# Build order enforced by install.sh:
#   1. localhost/base-admission    ← this file
#   2. localhost/<comp>-mid       ← composition Containerfile (FROM base-admission)
#   3. localhost/<comp>           ← base-graduation Containerfile (FROM <comp>-mid)
#
# This is a build dependency, not a launchable composition — it is NOT
# listed in crews/registry.json.
#
# Pinned base image — driven by KC_BASE_IMAGE build-arg from install.sh,
# which reads it from ghostship.conf (KC_BASE_IMAGE env var).
# Default here matches the config default so plain `podman build` still works.
#
# TRN-219: bumped 0.8.0 → 0.9.0-insider.4 for the KiroCrew 0.9.0 upgrade.
# 2026-10-17: bumped insider.4 → v0.9.0 stable. Multi-arch index digest —
# resolves correctly on amd64 (Linux) and arm64 (macOS).
# TRN-271: bumped v0.9.0 → v0.10.0. Multi-arch index digest (2026-10-26).
#           Resolves to amd64 on Linux, arm64 on macOS.
# TRN-293: bumped v0.10.0 → v0.11.1. Multi-arch index digest (2026-11-02).
#           KiroCrew version: v0.11.1 (kiro-cli 2.37.0). Resolves to amd64 on Linux, arm64 on macOS.
#           Digest: sha256:828ad5140a050414ef5bc9dd5c27e71bb92947ec31c8d2365eee7fa5eecbc587. Verified: 2026-11-02.
# TRN-307: bumped v0.11.1 → v0.11.2. Multi-arch index digest (2026-11-04).
#           KiroCrew version: v0.11.2, commit 31ee6e4 (kiro-cli 2.36.0). Resolves to amd64 on Linux, arm64 on macOS.
#           Digest: sha256:b912fdb52f92b9d23b5189e91b44fd01b531a38a2f7dad161f2185af2c24aef9. Verified: 2026-11-04.
# TRN-299: bumped v0.11.2 → v0.12.0. Multi-arch index digest (2026-11-05).
#           KiroCrew version: v0.12.0, commit f315771 (kiro-cli 2.27.1). Resolves to amd64 on Linux, arm64 on macOS.
#           Digest: sha256:d7eeab57ff9d4b265fcf05a2fa1352f1b238f730cfd6c65ebda4b36dcdef5d0f. Verified: 2026-11-05.
# ⚠️  The graduation-layer DB seed (crews/_base/graduation/seed_kiro_db.py) MUST
#     be re-verified against this exact base image before release — see TRN-271
#     tasks.md §1/§5. Bumping this pin without that verification is the silent
#     auth-injection regression the change guards against.
ARG KC_BASE_IMAGE=ghcr.io/kirodotdev/kirocrew@sha256:d7eeab57ff9d4b265fcf05a2fa1352f1b238f730cfd6c65ebda4b36dcdef5d0f
FROM ${KC_BASE_IMAGE}

USER root

# ghostship-mail: proper local mail delivery via mailutils + msmtp-mta
# Replaces hand-rolled mbox file-append. Local delivery only — no external SMTP.
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
      mailutils msmtp msmtp-mta && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# TRN-136: Ed25519 Admiral-mail verification (verify-admiral-sig) needs the
# `cryptography` package. It is NOT present in any layer of the upstream crew
# image, so pin it here — every composition inherits from this base, so the
# verifier can import cryptography.hazmat.primitives.asymmetric.ed25519 at
# runtime. Pinned exactly for a deterministic, reproducible image build; the
# raw Ed25519 API is stable, so this need not track the transport's version.
RUN pip3 install --no-cache-dir --break-system-packages 'cryptography==50.0.1'

# Provision Maildir mailboxes for all 7 local addresses
# (6 personas + captain; admiral is written by the transport only)
# Owned by kirocrew so agents can deliver without root or mail group.
RUN for mb in ghost spectre banshee wraith reaper raven captain; do \
      install -d -o kirocrew -g kirocrew -m 700 \
        /var/mail/$mb \
        /var/mail/$mb/new \
        /var/mail/$mb/cur \
        /var/mail/$mb/tmp; \
    done && chmod 1777 /var/mail

# Local mail delivery configuration
COPY --chown=root:root msmtprc /etc/msmtprc
COPY --chown=root:root maildeliver /usr/local/bin/maildeliver
COPY --chown=root:root sendmail-local /usr/local/bin/sendmail-local
RUN chmod 644 /etc/msmtprc && chmod 755 /usr/local/bin/maildeliver && \
    chmod 755 /usr/local/bin/sendmail-local && \
    ln -sf /usr/local/bin/sendmail-local /usr/sbin/sendmail

# Ed25519 verification helper for Admiral mail authenticity (TRN-136)
COPY --chown=root:root verify-admiral-sig /usr/local/bin/verify-admiral-sig
RUN chmod 755 /usr/local/bin/verify-admiral-sig

# Container-side helper scripts baked into every crew at /scripts/.
# Copied from transport/container_scripts/ by install.sh into the build context.
# server.py invokes these via `python3 /scripts/<name>.py` (TRN-74).
COPY --chown=root:root container_scripts/*.py /scripts/
RUN chmod 755 /scripts/*.py

# Ends as USER root — composition adds its own installs on top.
# base-graduation restores USER kirocrew.
