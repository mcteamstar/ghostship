# Graduation layer: applied after a composition to restore USER kirocrew and
# run kirocrew-owned setup steps. Every recruit who completes induction and
# their composition training graduates here before being commissioned.
#
# Takes MID_IMAGE as a build arg — the intermediate image produced by the
# composition's own Containerfile. install.sh builds this as the final step
# for each composition, tagging it as the launchable image.
#
# This is a build dependency, not a launchable composition — it is NOT
# listed in crews/registry.json.
ARG MID_IMAGE
FROM ${MID_IMAGE}

# Pre-seed the kiro-cli SQLite DB with schema + all migrations applied.
# At launch, transport only needs to INSERT auth_kv rows — no migration wait,
# no restart needed.
#
# ⚠️  FRAGILITY WARNING — read before updating KiroCrew:
# This schema and migration count (11 rows, versions 0–10) were extracted from
# the KiroCrew v0.12.2 image (kiro-cli 2.27.1, verified 2026-11-14 by static
# image-layer inspection — see seed_kiro_db.py). The active kiro-cli-chat runtime
# includes migrations through 010_pinned_bin_versions, including a BLOB state
# value and conversation tables. Re-verify both CLI and chat migrations when the
# base image changes.
#
# When updating the FROM image pin:
#   1. Start a disposable crew and run the normal CLI and chat task paths
#   2. Inspect the migrations table and all resulting table definitions in the
#      running container, including auth_kv and state
#   3. Update seed_kiro_db.py and its focused schema test to match
#
# Tracked in: README.md — "Extending the crew image"
COPY --chown=kirocrew:kirocrew seed_kiro_db.py /tmp/seed_kiro_db.py
USER kirocrew
RUN python3 /tmp/seed_kiro_db.py && rm /tmp/seed_kiro_db.py
