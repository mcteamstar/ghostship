#!/usr/bin/env python3
"""Verify X-Admiral-Sig on a message read from stdin or a file argument.

Exit codes:
  0 — valid signature (message is genuine Admiral mail)
  1 — signature mismatch (message is not genuine)
  2 — signing secret not found after retries (cannot verify; transient)

Usage:
  cat /var/mail/captain/new/<msg> | verify-admiral-sig
  verify-admiral-sig /var/mail/captain/new/<msg>
"""
import sys
import hmac
import hashlib
import email
import time

SECRET_PATH = '/home/kirocrew/.kiro/crew/.admiral_secret'
SECRET_PATH_FALLBACK = '/home/kirocrew/workplace/.admiral_secret'

MAX_RETRIES = 3
RETRY_DELAY_SECS = 2

if len(sys.argv) > 1:
    with open(sys.argv[1]) as f:
        msg = email.message_from_file(f)
else:
    msg = email.message_from_file(sys.stdin)

sig = msg.get('X-Admiral-Sig', '').strip()
subject = msg.get('Subject', '')
sender = msg.get('From', '')
body = (msg.get_payload() or '').rstrip('\n')

if not sig:
    # No signature header present — not Admiral mail
    sys.exit(1)

secret = None
for attempt in range(MAX_RETRIES):
    for path in (SECRET_PATH, SECRET_PATH_FALLBACK):
        try:
            with open(path) as f:
                secret = f.read().strip().encode()
            break
        except FileNotFoundError:
            continue
    if secret is not None:
        break
    # Secret not found — wait and retry (transient race with container startup)
    if attempt < MAX_RETRIES - 1:
        time.sleep(RETRY_DELAY_SECS)

if secret is None:
    # All retries exhausted — secret file absent (transient condition)
    sys.exit(2)

expected = hmac.new(
    secret,
    f'Subject:{subject}\nFrom:{sender}\n\n{body}'.encode('utf-8'),
    hashlib.sha256,
).hexdigest()
if hmac.compare_digest(sig, expected):
    sys.exit(0)
else:
    sys.exit(1)
