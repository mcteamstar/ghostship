#!/usr/bin/env python3
"""Verify X-Admiral-Sig on a message read from stdin.

Exit codes:
  0 — valid signature (message is genuine Admiral mail)
  1 — signature mismatch (message is not genuine)
  2 — signing secret not found (cannot verify)

Usage:
  cat /var/mail/captain/new/<msg> | verify-admiral-sig
"""
import sys
import hmac
import hashlib
import email

SECRET_PATH = '/home/kirocrew/workplace/.admiral_secret'

msg = email.message_from_file(sys.stdin)
sig = msg.get('X-Admiral-Sig', '').strip()
body = msg.get_payload() or ''

if not sig:
    # No signature header present — not Admiral mail
    sys.exit(1)

try:
    with open(SECRET_PATH) as f:
        secret = f.read().strip().encode()
except FileNotFoundError:
    sys.exit(2)

expected = hmac.new(secret, body.encode('utf-8'), hashlib.sha256).hexdigest()
if hmac.compare_digest(sig, expected):
    sys.exit(0)
else:
    sys.exit(1)
