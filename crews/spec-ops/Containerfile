# Spec-ops crew image — SDD (spec-driven development) tooling.
# Inherits shared infrastructure from localhost/base-admission.
# Adds Node.js (required for OpenSpec CLI) and the OpenSpec CLI itself.
#
# USER kirocrew is restored by the base-graduation layer applied by install.sh
# after this image is built. Do not add USER kirocrew here.
#
# Built locally at install time — not pushed to any registry.
FROM localhost/base-admission:latest

USER root

# Install Node.js 24 LTS via NodeSource — with integrity verification.
# The setup script is downloaded first and its SHA-256 is checked before
# execution.  Update NODESOURCE_SETUP_SHA256 when bumping Node.js versions
# (compute with: curl -fsSL https://deb.nodesource.com/setup_24.x | sha256sum).
ARG NODESOURCE_SETUP_SHA256="6e3d580f5bd7ccf2aa1e8df8d35c60d78e873c3ff8beb282c9bebd914904ad72"
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_24.x -o /tmp/nodesource_setup.sh && \
    echo "${NODESOURCE_SETUP_SHA256}  /tmp/nodesource_setup.sh" | sha256sum -c - && \
    bash /tmp/nodesource_setup.sh && \
    rm -f /tmp/nodesource_setup.sh && \
    apt-get install -y -qq --no-install-recommends nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# OpenSpec CLI — spec-driven development (propose/explore/apply/archive).
# Backs the openspec-* skills seeded from skills/ — those skills shell out
# to this binary, so it must be present for them to actually work. Pinned to
# match the version the skills/ SKILL.md files were generated with (see each
# file's `metadata.generatedBy`) — bumping the skills means bumping this too.
RUN npm install -g @fission-ai/openspec@1.9.0

# Claude Code toolchain — optional, controlled by the INCLUDE_CLAUDE_AGENT
# build arg (default: false). When true, installs TWO packages:
#   @agentclientprotocol/claude-agent-acp@0.79.0  — the ACP server binary
#     (the `claude-agent-acp` binary that KiroCrew's AcpClient spawns for
#     acp_backend="claude" sessions)
#   @anthropic-ai/claude-code@0.2.93  — the `claude` CLI binary
#     (required by claude-agent-acp via CLAUDE_CODE_EXECUTABLE; the ACP
#     server delegates model turns to the Claude Agent SDK which needs this)
#
# Headless tool-approval suppression: KiroCrew writes
# <work_dir>/.claude/settings.local.json with permissions.defaultMode set to
# "bypassPermissions" at session spawn time (see kiro_crew/acp/client.py
# _write_claude_local_settings). No environment variable override is needed
# from the ghostship side — KiroCrew handles it automatically via the
# dangerously_skip_permissions config key already set in _patch_crew_config.
ARG INCLUDE_CLAUDE_AGENT=false
RUN if [ "${INCLUDE_CLAUDE_AGENT}" = "true" ]; then \
      npm install -g @agentclientprotocol/claude-agent-acp@0.79.0 && \
      npm install -g @anthropic-ai/claude-code@0.2.93; \
    fi

# Codex toolchain — optional, controlled by the INCLUDE_CODEX_AGENT build arg
# (default: false). When true, installs ONE package:
#   @agentclientprotocol/codex-acp@1.12.0 — the ACP server binary that
#     KiroCrew's AcpClient spawns for acp_backend="codex" sessions.
#
# Unlike Claude (which needs both claude-agent-acp AND the separate `claude`
# CLI), codex-acp is a SINGLE component: the adapter ships its own compatible
# Codex binary, so there is no second `codex` CLI to install and no CODEX_PATH
# wiring — resolution honours a CODEX_ACP_BIN override if one is ever needed.
#
# Login / headless behaviour (task 1.2): codex-acp reads its credentials from
#   ~/.codex/auth.json  (relocatable via the CODEX_HOME env var).
# Two auth paths are supported:
#   - API key: the OPENAI_API_KEY env var (injected at crew-container creation
#     from GA_CREW_OPENAI_API_KEY) authenticates without any login flow.
#   - OAuth (ChatGPT subscription): a device / browser sign-in that writes
#     ~/.codex/auth.json. ghostship drives this in an ephemeral
#     ga-codex-login-* container (spec-ops image), captures the resulting
#     ~/.codex/ as the ga-codex-auth tar, and untars it into the crew
#     container's ~/.codex/ at launch. The login flow surfaces a login_url
#     (a device code may or may not accompany it — the codex-auth spec permits
#     a code-less response), extracted from the login container's PTY output.
# OPENAI_BASE_URL redirects codex-acp to an OpenAI-compatible endpoint.
ARG INCLUDE_CODEX_AGENT=false
RUN if [ "${INCLUDE_CODEX_AGENT}" = "true" ]; then \
      npm install -g @agentclientprotocol/codex-acp@1.12.0; \
    fi

ARG VERSION=0.0.0-dev
LABEL org.ghostship.version=$VERSION
