# Spec-ops crew image — SDD (spec-driven development) tooling.
# Inherits shared infrastructure from localhost/base-admission.
# Adds Node.js (required for OpenSpec CLI) and the OpenSpec CLI itself.
#
# USER kirocrew is restored by the base-graduation layer applied by install.sh
# after this image is built. Do not add USER kirocrew here.
#
# Built locally at install time — not pushed to any registry.
FROM localhost/base-admission:latest

USER root

# Install Node.js 24 LTS via NodeSource — with integrity verification.
# The setup script is downloaded first and its SHA-256 is checked before
# execution.  Update NODESOURCE_SETUP_SHA256 when bumping Node.js versions
# (compute with: curl -fsSL https://deb.nodesource.com/setup_24.x | sha256sum).
ARG NODESOURCE_SETUP_SHA256="6e3d580f5bd7ccf2aa1e8df8d35c60d78e873c3ff8beb282c9bebd914904ad72"
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_24.x -o /tmp/nodesource_setup.sh && \
    echo "${NODESOURCE_SETUP_SHA256}  /tmp/nodesource_setup.sh" | sha256sum -c - && \
    bash /tmp/nodesource_setup.sh && \
    rm -f /tmp/nodesource_setup.sh && \
    apt-get install -y -qq --no-install-recommends nodejs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# OpenSpec CLI — spec-driven development (propose/explore/apply/archive).
# Backs the openspec-* skills seeded from skills/ — those skills shell out
# to this binary, so it must be present for them to actually work. Pinned to
# match the version the skills/ SKILL.md files were generated with (see each
# file's `metadata.generatedBy`) — bumping the skills means bumping this too.
RUN npm install -g @fission-ai/openspec@1.14.3

# Optional agent toolchains (TRN-202). install.sh passes AGENT_TOOLCHAINS: the
# optional backends listed in GA_AGENT_BACKENDS (kiro is bundled in the base
# image and never listed). Each name runs toolchains/<name>.sh, which owns its
# pinned versions. Adding a backend means adding a script; this block and
# install.sh don't change. The label lets install.sh detect a changed list and
# force a cache-less rebuild, since podman can reuse a layer when only a
# build arg changes.
ARG AGENT_TOOLCHAINS=""
COPY toolchains/ /tmp/toolchains/
RUN set -e; \
    for name in $(echo "${AGENT_TOOLCHAINS}" | tr ',' ' '); do \
      case "$name" in ''|[!a-z]*|*[!a-z0-9-]*) echo "Invalid agent toolchain name: '$name'" >&2; exit 1;; esac; \
      echo "Installing agent toolchain: $name"; \
      sh "/tmp/toolchains/$name.sh" || { echo "Agent toolchain failed: $name" >&2; exit 1; }; \
    done; \
    rm -rf /tmp/toolchains
LABEL org.ghostship.toolchains=$AGENT_TOOLCHAINS

# Preserve the signing-key credential mask on rootless Linux (TRN-312).
COPY patch_sandbox_seal.py /tmp/patch_sandbox_seal.py
RUN python3 /tmp/patch_sandbox_seal.py && rm /tmp/patch_sandbox_seal.py

ARG VERSION=0.0.0-dev
LABEL org.ghostship.version=$VERSION

# Bake mcteamstar/.agents into the image so AcademyLoader can exec
# `.agents/setup` at launch time without any network call.
# Fetch runs as root then chowns to kirocrew (D5 in design.md: kirocrew-owned).
# AGENTS_REF pins the commit baked into the image. Bump it deliberately for each
# .agents update (see docs/dependencies.md); a changed value triggers a cache-less
# rebuild via the org.ghostship.agents_ref label. git fetch accepts a full commit
# SHA, a branch or a tag, so machine.images.agents_ref can still override it.
ARG AGENTS_URL="https://github.com/mcteamstar/.agents.git"
ARG AGENTS_REF="3ca5a8822a9622012a7cad9a2383e88e7919ab1d"
RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends git && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    git init -q /home/kirocrew/.agents && \
    git -C /home/kirocrew/.agents fetch -q --depth 1 "${AGENTS_URL}" "${AGENTS_REF}" && \
    git -C /home/kirocrew/.agents checkout -q FETCH_HEAD && \
    git -C /home/kirocrew/.agents rev-parse HEAD > /home/kirocrew/.agents-commit && \
    chown -R kirocrew:kirocrew /home/kirocrew/.agents /home/kirocrew/.agents-commit && \
    chmod +x /home/kirocrew/.agents/setup
LABEL org.ghostship.agents_ref=$AGENTS_REF
