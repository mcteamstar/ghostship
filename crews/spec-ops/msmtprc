# msmtp configuration — NOT USED for delivery.
# msmtp-mta is installed only for the /usr/sbin/sendmail compat binary;
# we override it with a wrapper that pipes to /usr/local/bin/maildeliver.
# This file exists only to silence msmtp warnings if it is ever invoked
# directly (which it should not be — sendmail is replaced at image build).

defaults
syslog on

account default
host 127.0.0.1
port 25
from kirocrew@localhost
