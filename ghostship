#!/usr/bin/env python3
"""ghostship — command-line interface for Ghost Academy transport management.

Usage:
    ghostship <subcommand> [flags]

Subcommands:
    install    [flags]   Install or update the transport (runs scripts/install.sh)
    start      [flags]   Start the transport (runs scripts/start.sh)
    stop                 Stop the ga-transport container
    upgrade    [flags]   Rebuild and restart the transport (runs scripts/install.sh)
    uninstall  [flags]   Uninstall the transport (runs scripts/uninstall.sh)
    status               Show transport status (container running, port, uptime)
    init       [flags]   Register the MCP server and install skill symlinks for agent clients
    version              Print the ghostship version

Run 'ghostship <subcommand> --help' for subcommand-specific flags.
"""

import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _ghostship_dir() -> pathlib.Path:
    """Absolute path to the directory containing this script."""
    return pathlib.Path(__file__).resolve().parent


def _version() -> str:
    version_file = _ghostship_dir() / "VERSION"
    try:
        return version_file.read_text().strip()
    except FileNotFoundError:
        return "unknown"


def _exec_script(script_rel: str, extra_args: list) -> None:
    """Replace the current process with scripts/<script> forwarding all args."""
    script = _ghostship_dir() / script_rel
    if not script.exists():
        print(f"error: script not found: {script}", file=sys.stderr)
        sys.exit(1)
    os.execv(str(script), [str(script)] + extra_args)


# ---------------------------------------------------------------------------
# Subcommand: version
# ---------------------------------------------------------------------------

def cmd_version(args: list) -> int:
    print(_version())
    return 0


# ---------------------------------------------------------------------------
# Subcommand: install / upgrade / start / uninstall
# ---------------------------------------------------------------------------

def cmd_install(args: list) -> int:
    _exec_script("scripts/install.sh", args)


def cmd_start(args: list) -> int:
    _exec_script("scripts/start.sh", args)


def cmd_upgrade(args: list) -> int:
    """Rebuild images and restart the transport (alias for install)."""
    _exec_script("scripts/install.sh", args)


def cmd_uninstall(args: list) -> int:
    _exec_script("scripts/uninstall.sh", args)


# ---------------------------------------------------------------------------
# Subcommand: stop
# ---------------------------------------------------------------------------

def _podman_cmd() -> list:
    """Return the base podman command list, honouring GA_MACHINE_NAME on macOS."""
    import platform
    if platform.system() == "Darwin":
        machine = os.environ.get("GA_MACHINE_NAME", "ghost-academy")
        dedicated = os.environ.get("GA_DEDICATED_MACHINE", "true").lower() == "true"
        if dedicated:
            return ["podman", "--connection", machine]
    return ["podman"]


def cmd_stop(args: list) -> int:
    podman = _podman_cmd()
    if not shutil.which(podman[0]):
        print("ga-transport container not found — nothing to stop")
        return 0
    result = subprocess.run(
        podman + ["stop", "ga-transport"],
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        print("✓ ga-transport stopped")
        return 0
    # Container not found → exit 0 with a message
    stderr_lower = result.stderr.lower()
    if "no such container" in stderr_lower or "no container" in stderr_lower or "error" in stderr_lower:
        # Check if it truly doesn't exist
        check = subprocess.run(
            podman + ["inspect", "ga-transport", "--format", "{{.State.Status}}"],
            capture_output=True,
            text=True,
        )
        if check.returncode != 0:
            print("ga-transport container not found — nothing to stop")
            return 0
    print(result.stderr.strip(), file=sys.stderr)
    return result.returncode


# ---------------------------------------------------------------------------
# Subcommand: status
# ---------------------------------------------------------------------------

def cmd_status(args: list) -> int:
    podman = _podman_cmd()

    # Bail gracefully if podman isn't installed
    if not shutil.which(podman[0]):
        print("ghostship status: not installed (podman not found)")
        print("  Install Podman, then run 'ghostship install'.")
        return 0

    # Check if the container exists and get its state
    inspect = subprocess.run(
        podman + [
            "inspect", "ga-transport",
            "--format",
            "{{.State.Status}}\t{{.State.StartedAt}}\t{{json .NetworkSettings.Ports}}",
        ],
        capture_output=True,
        text=True,
    )

    if inspect.returncode != 0:
        # Container doesn't exist at all
        print("ghostship status: not installed (ga-transport container not found)")
        print("  Run 'ghostship install' to set up the transport.")
        return 0

    output = inspect.stdout.strip()
    parts = output.split("\t", 2)
    state = parts[0] if len(parts) > 0 else "unknown"
    started_at = parts[1] if len(parts) > 1 else ""
    ports_json = parts[2] if len(parts) > 2 else "{}"

    if state != "running":
        print(f"ghostship status: stopped (container state: {state})")
        print("  Run 'ghostship start' to bring it back up.")
        return 0

    # Parse port bindings
    port_str = "unknown"
    try:
        ports = json.loads(ports_json)
        # ports is like {"64057/tcp": [{"HostIp": "127.0.0.1", "HostPort": "64057"}]}
        for _proto_key, bindings in ports.items():
            if bindings:
                host_port = bindings[0].get("HostPort", "")
                host_ip = bindings[0].get("HostIp", "127.0.0.1")
                if host_port:
                    port_str = f"{host_ip}:{host_port}"
                    break
    except (json.JSONDecodeError, AttributeError, TypeError):
        pass

    # Compute uptime
    uptime_str = ""
    if started_at:
        try:
            from datetime import datetime, timezone
            # started_at may be like "2026-08-31T20:00:00.123456789Z"
            # Trim nanoseconds to microseconds (Python only handles 6 digits)
            ts = started_at
            if "." in ts:
                dot = ts.index(".")
                suffix = ts[dot + 1:]
                tz_char = None
                for ch in ("Z", "+", "-"):
                    idx = suffix.find(ch)
                    if idx != -1:
                        tz_char = suffix[idx:]
                        suffix = suffix[:idx]
                        break
                suffix = suffix[:6]  # microseconds only
                ts = ts[:dot + 1] + suffix + (tz_char or "Z")
            ts = ts.replace("Z", "+00:00")
            started = datetime.fromisoformat(ts)
            now = datetime.now(timezone.utc)
            delta = now - started
            total_seconds = int(delta.total_seconds())
            if total_seconds < 60:
                uptime_str = f"{total_seconds}s"
            elif total_seconds < 3600:
                uptime_str = f"{total_seconds // 60}m {total_seconds % 60}s"
            else:
                h = total_seconds // 3600
                m = (total_seconds % 3600) // 60
                uptime_str = f"{h}h {m}m"
        except Exception:
            uptime_str = started_at

    print("ghostship status: running ✓")
    print(f"  URL:    http://{port_str}/mcp")
    if uptime_str:
        print(f"  Uptime: {uptime_str}")
    return 0


# ---------------------------------------------------------------------------
# Subcommand: init
# ---------------------------------------------------------------------------

_DEFAULT_URL = "http://localhost:64057/mcp"
_SKILLS = ["ghostship-command", "ghostship-admin", "ghostship-capability"]


def _skills_source_dir() -> pathlib.Path:
    return _ghostship_dir() / ".claude-plugin" / "skills"


def _wire_skills(client_skills_dir: pathlib.Path, label: str) -> None:
    """Create symlinks in client_skills_dir for the three ghostship skills."""
    source = _skills_source_dir()
    client_skills_dir.mkdir(parents=True, exist_ok=True)
    for skill in _SKILLS:
        target = source / skill
        link = client_skills_dir / skill
        if link.is_symlink():
            current_target = link.resolve()
            expected_target = target.resolve()
            if current_target == expected_target:
                # Already correct — skip silently
                continue
            # Symlink exists but points somewhere else (repo was moved)
            print(f"  [{label}] note: {skill} symlink target changed "
                  f"(was {current_target}, now {expected_target}) — updating")
            link.unlink()
        elif link.exists():
            # Not a symlink but something else exists — leave it alone
            print(f"  [{label}] skip: {skill} already exists at {link} (not a symlink)")
            continue
        link.symlink_to(target)
        print(f"  [{label}] ✓ skill symlink: {link} → {target}")


def _kiro_mcp_config_path() -> pathlib.Path:
    """Return the path to kiro's global MCP config file."""
    return pathlib.Path.home() / ".kiro" / "settings" / "mcp.json"


def _init_kiro(url: str, api_key: str) -> bool:
    """Register ghostship MCP server and wire skills for kiro-cli."""
    if shutil.which("kiro-cli") is None:
        return False

    print("[kiro] kiro-cli detected")

    # Register via kiro-cli CLI first (no --headers flag; we apply the header
    # via direct JSON edit after if an api-key is provided).
    add_cmd = [
        "kiro-cli", "mcp", "add",
        "--name", "ghostship",
        "--url", url,
        "--scope", "global",
        "--force",  # idempotent overwrite if already present
    ]
    result = subprocess.run(add_cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"[kiro]   error: could not register MCP server: {result.stderr.strip()}")
        return True  # kiro-cli detected, but registration failed

    print(f"[kiro] ✓ MCP server registered: {url}")

    # Apply api-key header directly to the mcp.json config file.
    # kiro-cli mcp add does not support --headers, so we write the header field
    # ourselves using the same mcp.json schema that kiro reads at runtime.
    if api_key:
        cfg_path = _kiro_mcp_config_path()
        try:
            config = json.loads(cfg_path.read_text(encoding="utf-8")) if cfg_path.exists() else {}
            if "mcpServers" not in config:
                config["mcpServers"] = {}
            if "ghostship" not in config["mcpServers"]:
                config["mcpServers"]["ghostship"] = {}
            config["mcpServers"]["ghostship"]["headers"] = {
                "Authorization": f"Bearer {api_key}"
            }
            cfg_path.parent.mkdir(parents=True, exist_ok=True)
            fd, tmp_path = tempfile.mkstemp(
                dir=cfg_path.parent, prefix=".ghostship-init-", suffix=".tmp"
            )
            try:
                with os.fdopen(fd, "w", encoding="utf-8") as fh:
                    json.dump(config, fh, indent=2)
                    fh.write("\n")
                os.replace(tmp_path, cfg_path)
            except Exception:
                os.unlink(tmp_path)
                raise
            print(f"[kiro]   ✓ Authorization header written to {cfg_path}")
        except OSError as exc:
            print(f"[kiro]   warning: could not write api-key header to {cfg_path}: {exc}")

    # Wire skills
    kiro_skills = pathlib.Path.home() / ".kiro" / "skills"
    _wire_skills(kiro_skills, "kiro")
    return True


def _find_claude_config() -> pathlib.Path:
    """Return the Claude Code config path that exists, or the default creation path."""
    candidates = [
        pathlib.Path.home() / ".claude.json",
        pathlib.Path.home() / ".config" / "claude" / "claude.json",
    ]
    for p in candidates:
        if p.exists():
            return p
    # Default creation path
    return candidates[0]


def _init_claude(url: str, api_key: str) -> bool:
    """Register ghostship MCP server and wire skills for Claude Code."""
    cfg_path = _find_claude_config()
    claude_detected = cfg_path.exists()

    if not claude_detected:
        return False

    print("[claude] Claude Code config detected")

    # Read existing config
    try:
        with cfg_path.open("r", encoding="utf-8") as fh:
            config = json.load(fh)
    except (json.JSONDecodeError, OSError) as exc:
        print(f"[claude]   error: could not read {cfg_path}: {exc}")
        return True

    # Build the server entry
    entry: dict = {"type": "http", "url": url}
    if api_key:
        entry["headers"] = {"Authorization": f"Bearer {api_key}"}

    # Merge surgically — only touch mcpServers.ghostship
    if "mcpServers" not in config:
        config["mcpServers"] = {}
    config["mcpServers"]["ghostship"] = entry

    # Write back atomically
    try:
        cfg_path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp_path = tempfile.mkstemp(
            dir=cfg_path.parent, prefix=".ghostship-init-", suffix=".tmp"
        )
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                json.dump(config, fh, indent=2)
                fh.write("\n")
            os.replace(tmp_path, cfg_path)
        except Exception:
            os.unlink(tmp_path)
            raise
    except OSError as exc:
        print(f"[claude]   error: could not write {cfg_path}: {exc}")
        return True

    print(f"[claude] ✓ MCP server registered in {cfg_path}: {url}")

    # Wire skills
    claude_skills = pathlib.Path.home() / ".claude" / "skills"
    _wire_skills(claude_skills, "claude")
    return True


def _init_claude_unconditional(url: str, api_key: str) -> None:
    """Like _init_claude but creates the config if neither path exists."""
    cfg_path = _find_claude_config()
    config: dict = {}
    if cfg_path.exists():
        try:
            with cfg_path.open("r", encoding="utf-8") as fh:
                config = json.load(fh)
        except (json.JSONDecodeError, OSError) as exc:
            print(f"[claude]   error: could not read {cfg_path}: {exc}")
            return

    entry: dict = {"type": "http", "url": url}
    if api_key:
        entry["headers"] = {"Authorization": f"Bearer {api_key}"}

    if "mcpServers" not in config:
        config["mcpServers"] = {}
    config["mcpServers"]["ghostship"] = entry

    try:
        cfg_path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp_path = tempfile.mkstemp(
            dir=cfg_path.parent, prefix=".ghostship-init-", suffix=".tmp"
        )
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                json.dump(config, fh, indent=2)
                fh.write("\n")
            os.replace(tmp_path, cfg_path)
        except Exception:
            os.unlink(tmp_path)
            raise
    except OSError as exc:
        print(f"[claude]   error: could not write {cfg_path}: {exc}")
        return

    print(f"[claude] ✓ MCP server registered in {cfg_path}: {url}")

    claude_skills = pathlib.Path.home() / ".claude" / "skills"
    _wire_skills(claude_skills, "claude")


def cmd_init(args: list) -> int:
    # Parse flags
    agent = None   # None = auto-detect
    url = _DEFAULT_URL
    api_key = ""

    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--help", "-h"):
            print(
                "Usage: ghostship init [--agent kiro|claude|all] "
                "[--url <url>] [--api-key <key>]\n"
                "\n"
                "  --agent   Target agent client: kiro, claude, or all.\n"
                "            Default: auto-detect both kiro-cli and Claude Code.\n"
                "  --url     MCP server URL (default: http://localhost:64057/mcp)\n"
                "  --api-key Bearer token for the MCP endpoint (optional)\n"
            )
            return 0
        elif a == "--agent":
            if i + 1 >= len(args):
                print("error: --agent requires a value (kiro, claude, all)", file=sys.stderr)
                return 1
            agent = args[i + 1]
            if agent not in ("kiro", "claude", "all"):
                print(f"error: unknown --agent value '{agent}' (use kiro, claude, or all)",
                      file=sys.stderr)
                return 1
            i += 2
        elif a == "--url":
            if i + 1 >= len(args):
                print("error: --url requires a value", file=sys.stderr)
                return 1
            url = args[i + 1]
            i += 2
        elif a == "--api-key":
            if i + 1 >= len(args):
                print("error: --api-key requires a value", file=sys.stderr)
                return 1
            api_key = args[i + 1]
            i += 2
        else:
            print(f"error: unknown flag '{a}'", file=sys.stderr)
            return 1

    print(f"ghostship init — url: {url}")
    if api_key:
        print("  api-key: (set)")

    wired_any = False

    if agent is None:
        # Auto-detect
        kiro_wired = _init_kiro(url, api_key)
        claude_wired = _init_claude(url, api_key)
        wired_any = kiro_wired or claude_wired
    elif agent == "all":
        # Unconditional — report errors per-agent, not fatal
        kiro_wired = _init_kiro(url, api_key)
        if not kiro_wired:
            print("[kiro]   kiro-cli not found on PATH — skipping")
        _init_claude_unconditional(url, api_key)
        wired_any = True
    elif agent == "kiro":
        kiro_wired = _init_kiro(url, api_key)
        if not kiro_wired:
            print("[kiro]   kiro-cli not found on PATH")
        wired_any = kiro_wired
    elif agent == "claude":
        _init_claude_unconditional(url, api_key)
        wired_any = True

    if not wired_any and agent is None:
        print("No supported agent client found (kiro-cli or Claude Code).")
        print("Nothing to do. Re-run with --agent kiro or --agent claude to force.")
        return 0

    if wired_any:
        print("\nghostship init complete.")
        print("  If symlinks were moved, re-run 'ghostship init' to update them.")
    return 0


# ---------------------------------------------------------------------------
# Usage / dispatch
# ---------------------------------------------------------------------------

_USAGE = """\
Usage: ghostship <subcommand> [flags]

Subcommands:
  install    [flags]   Install or update the transport (runs scripts/install.sh)
  start      [flags]   Start the transport (runs scripts/start.sh)
  stop                 Stop the ga-transport container
  upgrade    [flags]   Rebuild and restart the transport (same as install)
  uninstall  [flags]   Uninstall the transport (runs scripts/uninstall.sh)
  status               Show transport status
  init       [flags]   Wire MCP server + skills for agent clients (kiro-cli, Claude Code)
  version              Print ghostship version

Run 'ghostship <subcommand> --help' for flags specific to that subcommand.
"""

_COMMANDS = {
    "install":   cmd_install,
    "start":     cmd_start,
    "stop":      cmd_stop,
    "upgrade":   cmd_upgrade,
    "uninstall": cmd_uninstall,
    "status":    cmd_status,
    "init":      cmd_init,
    "version":   cmd_version,
}


def main() -> int:
    args = sys.argv[1:]

    if not args or args[0] in ("--help", "-h"):
        print(_USAGE, end="")
        return 0

    subcmd = args[0]
    if subcmd in ("--version", "-V"):
        return cmd_version([])

    handler = _COMMANDS.get(subcmd)
    if handler is None:
        print(f"error: unknown subcommand '{subcmd}'", file=sys.stderr)
        print(f"Run 'ghostship --help' for available subcommands.", file=sys.stderr)
        return 1

    return handler(args[1:]) or 0


if __name__ == "__main__":
    sys.exit(main())
