#!/usr/bin/env python3
"""ghostship — command-line interface for Ghost Academy transport management.

Usage:
    ghostship <subcommand> [flags]

Subcommands:
    install    [flags]   Install or update the transport (runs bin/install.sh)
    start      [flags]   Start the transport (runs bin/start.sh)
    stop                 Stop the transport, portal, and Podman machine/service
    upgrade    [flags]   Rebuild and restart the transport (runs bin/install.sh); --skills also refreshes skills
    uninstall  [flags]   Uninstall the transport (runs bin/uninstall.sh)
    status               Show transport status (container running, port, uptime)
    setup      [flags]   Register the MCP server and install skill symlinks for agent clients
    version              Print the ghostship version

Run 'ghostship <subcommand> --help' for subcommand-specific flags.
"""

import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _ghostship_dir() -> pathlib.Path:
    """Absolute path to the directory containing this script."""
    return pathlib.Path(__file__).resolve().parent


def _version() -> str:
    version_file = _ghostship_dir() / "VERSION"
    try:
        return version_file.read_text().strip()
    except FileNotFoundError:
        return "unknown"


def _exec_script(script_rel: str, extra_args: list) -> None:
    """Replace the current process with bin/<script> (or scripts/ for dev tools) forwarding all args."""
    script = _ghostship_dir() / script_rel
    if not script.exists():
        print(f"error: script not found: {script}", file=sys.stderr)
        sys.exit(1)
    os.execv(str(script), [str(script)] + extra_args)


# ---------------------------------------------------------------------------
# Subcommand: version
# ---------------------------------------------------------------------------

def cmd_version(args: list) -> int:
    print(_version())
    return 0


# ---------------------------------------------------------------------------
# Subcommand: install / upgrade / start / uninstall
# ---------------------------------------------------------------------------

def cmd_install(args: list) -> int:
    if "--help" in args or "-h" in args:
        print("Usage: ghostship install [flags]\n"
              "\nInstall or update the Ghost Academy transport.\n"
              "Delegates to bin/install.sh — run 'ghostship install --help' "
              "after removing this flag to see all install.sh flags.")
        return 0
    # Forward ALL extra args unchanged to bin/install.sh, including
    # --client-only / --url / --api-key (TRN-115) — no per-flag handling here.
    _exec_script("bin/install.sh", args)


def cmd_start(args: list) -> int:
    if "--help" in args or "-h" in args:
        print("Usage: ghostship start [flags]\n"
              "\nStart the transport (no-op if already running).\n"
              "Delegates to bin/start.sh.")
        return 0
    _exec_script("bin/start.sh", args)


def cmd_upgrade(args: list) -> int:
    """Rebuild images and restart the transport (alias for install)."""
    if "--help" in args or "-h" in args:
        print("Usage: ghostship upgrade [--skills] [flags]\n"
              "\nRebuild images and recreate the transport container.\n"
              "Equivalent to 'ghostship install'. Delegates to bin/install.sh.\n"
              "\n"
              "  --skills   After a successful rebuild, also run 'ghostship setup' to\n"
              "             refresh skill symlinks and re-register the MCP server for\n"
              "             all detected agent clients (kiro-cli, Claude Code, opencode).")
        return 0
    skills = "--skills" in args
    install_args = [a for a in args if a != "--skills"]
    if not skills:
        # Fast path: replace the process entirely (original behaviour).
        _exec_script("bin/install.sh", install_args)
        return 0  # unreachable in production (execvp), needed for tests
    # --skills path: run install as a subprocess so we can chain setup after.
    script = _ghostship_dir() / "scripts" / "install.sh"
    if not script.exists():
        print(f"error: script not found: {script}", file=sys.stderr)
        return 1
    result = subprocess.run([str(script)] + install_args)
    if result.returncode != 0:
        return result.returncode
    return cmd_setup([])


def cmd_uninstall(args: list) -> int:
    if "--help" in args or "-h" in args:
        print("Usage: ghostship uninstall [flags]\n"
              "\nTear down the Ghost Academy transport.\n"
              "Delegates to bin/uninstall.sh.")
        return 0
    _exec_script("bin/uninstall.sh", args)


