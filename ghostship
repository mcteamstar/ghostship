def _discover_transport(args: list) -> tuple[str, str | None]:
    """Return (base_url, api_key) via the full discovery chain.

    Order: flag → env → Podman inspect → default.
    """
    # URL: flag > GHOSTSHIP_URL env > Podman inspect > default
    url = None
    if "--url" in args:
        idx = args.index("--url")
        if idx + 1 < len(args):
            url = args[idx + 1]
    if not url:
        url = os.environ.get("GHOSTSHIP_URL") or ""
    if not url:
        url = _inspect_installed_url() or ""
    if not url:
        url = "http://localhost:64057"
    url = url.rstrip("/")

    # API key: flag > GHOSTSHIP_API_KEY env > Podman inspect data dir
    api_key = None
    if "--api-key" in args:
        idx = args.index("--api-key")
        if idx + 1 < len(args):
            api_key = args[idx + 1]
    if not api_key:
        api_key = os.environ.get("GHOSTSHIP_API_KEY") or None
    if not api_key:
        api_key = _inspect_installed_api_key() or None

    return url, api_key


def _inspect_installed_url() -> str:
    """Try to discover the installed transport URL via Podman inspect.

    ga-transport publishes no host port — clients reach it through ga-portal —
    so its port bindings say nothing. install.sh bakes the public URL into
    ga-transport's GA_HOST_URL (derived from HOST and PORT unless --public-url
    overrides it), which is exactly the base URL a client should use.
    """
    podman = _find_podman()
    if not podman:
        return ""
    try:
        result = subprocess.run(
            podman + ["inspect", "ga-transport", "--format", "{{json .Config.Env}}"],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0 or not result.stdout.strip():
            return ""
        for item in json.loads(result.stdout.strip()) or []:
            if isinstance(item, str) and item.startswith("GA_HOST_URL="):
                return item.split("=", 1)[1].strip().rstrip("/")
    except Exception:
        pass
    return ""


def _inspect_installed_api_key() -> str:
    """Try to read ga-api-key from the transport's /data mount via Podman inspect."""
    podman = _find_podman()
    if not podman:
        return ""
    try:
        result = subprocess.run(
            podman + ["inspect", "ga-transport", "--format", "{{json .Mounts}}"],
            capture_output=True, text=True, timeout=5,
        )
        if result.returncode != 0 or not result.stdout.strip():
            return ""
        mounts = json.loads(result.stdout.strip())
        for mount in mounts:
            if mount.get("Destination") == "/data":
                src = mount.get("Source", "")
                key_path = pathlib.Path(src) / "ga-api-key"
                try:
                    return key_path.read_text().strip()
                except (OSError, PermissionError):
                    pass
    except Exception:
        pass
    return ""


def _find_podman() -> list | None:
    """Return the podman command list targeting the right socket/machine, or None.

    Mirrors _podman_cmd() but returns None instead of a bare fallback when
    podman is not available. Used by _inspect_installed_url and
    _inspect_installed_api_key, which need to reach the same instance that
    hosts ga-transport (e.g. the dedicated ghost-academy socket on Linux).
    """
    import platform

    base = None
    for cmd in (["podman"], ["podman-remote"]):
        if shutil.which(cmd[0]):
            base = cmd[0]
            break
    if base is None:
        return None

    # Honour the same dedicated socket/machine logic as _podman_cmd()
    sock = os.environ.get("PODMAN_SOCK", "")
    if sock:
        return [base, "--url", f"unix://{sock}"]

    machine = os.environ.get("GA_MACHINE_NAME", "ghost-academy")
    dedicated = os.environ.get("GA_DEDICATED_MACHINE", "true").lower() == "true"

    if platform.system() == "Darwin":
        if dedicated:
            return [base, "--connection", machine]
    else:
        if dedicated:
            runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
            sock_path = f"{runtime}/{machine}/podman.sock"
            if os.path.exists(sock_path):
                return [base, "--url", f"unix://{sock_path}"]

    return [base]


def _is_safe_url(url: str) -> bool:
    """Return True if url is https:// or targets a loopback host."""
    import urllib.parse
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme == "https":
        return True
    hostname = parsed.hostname or ""
    if hostname in ("localhost", "127.0.0.1", "::1"):
        return True
    # 127.x.x.x range
    if hostname.startswith("127."):
        return True
    return False


def _read_secret(prompt: str) -> str:
    """Read a secret from a hidden prompt (tty) or stdin (piped)."""
    import getpass
    if sys.stdin.isatty():
        return getpass.getpass(prompt)
    else:
        return sys.stdin.read().strip()


def _http_json(url: str, method: str, body=None, api_key=None):
    """Perform an HTTP request and return the parsed JSON response."""
    data = None
    headers = {"Accept": "application/json"}
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    if api_key:
        headers["Authorization"] = f"Bearer {api_key}"
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    with urllib.request.urlopen(req) as resp:
        raw = resp.read().decode("utf-8")
    if not raw:
        return {}
    return json.loads(raw)


def _poll_flow(base_url: str, backend: str, api_key: str | None,
               login_url: str, code: str) -> int:
    """Poll GET /login/{backend} until the flow completes. Return 0 on success."""
    elapsed = 0
    poll_url = f"{base_url}/login/{backend}"
    while elapsed < _AUTH_TIMEOUT:
        time.sleep(_AUTH_POLL_INTERVAL)
        elapsed += _AUTH_POLL_INTERVAL
        print(".", end="", flush=True)
        try:
            poll = _http_json(poll_url, "GET", api_key=api_key)
        except urllib.error.HTTPError as exc:
            print()
            try:
                body = exc.read().decode("utf-8", errors="replace").strip()
            except Exception:
                body = exc.reason
            print(f"error: transport returned HTTP {exc.code} while polling: {body}",
                  file=sys.stderr)
            return 1
        except urllib.error.URLError as exc:
            print()
            print(f"error: lost connection to transport — {exc.reason}",
                  file=sys.stderr)
            return 1
        status = poll.get("status")
        if status == "complete":
            print()
            print("Authenticated successfully.")
            return 0
    print()
    print("error: authentication timed out before completion.", file=sys.stderr)
    if login_url:
        print(f"  Retry at: {login_url}", file=sys.stderr)
    return 1


def auth_login(args: list) -> int:
    """ghostship auth login <backend> [--method <m>] [--yes] [--insecure]
    [--identity-provider <url>] [--region <r>]"""
    # Parse backend
    positional = [a for a in args if not a.startswith("-")]
    if not positional:
        print("error: backend required (kiro, claude, codex)", file=sys.stderr)
        print(_AUTH_USAGE, end="", file=sys.stderr)
        return 1
    backend = positional[0]
    if backend not in _VALID_BACKENDS:
        print(f"error: unknown backend '{backend}'. Valid backends: {', '.join(_VALID_BACKENDS)}",
              file=sys.stderr)
        return 1

    base_url, api_key = _discover_transport(args)

    # Parse flags
    method = None
    if "--method" in args:
        idx = args.index("--method")
        if idx + 1 < len(args):
            method = args[idx + 1]
    yes = "--yes" in args
    insecure = "--insecure" in args
    identity_provider = None
    if "--identity-provider" in args:
        idx = args.index("--identity-provider")
        if idx + 1 < len(args):
            identity_provider = args[idx + 1]
    if not identity_provider:
        identity_provider = os.environ.get("KIRO_IDENTITY_PROVIDER") or None
    region = None
    if "--region" in args:
        idx = args.index("--region")
        if idx + 1 < len(args):
            region = args[idx + 1]
    if not region:
        region = os.environ.get("KIRO_REGION") or None

    # For kiro identity-center, fetch defaults from transport config if not set.
    if backend == "kiro" and (not identity_provider or not region):
        try:
            _status = _http_json(f"{base_url}/login/kiro", "GET", api_key=api_key)
            _ic = _status.get("identity_center") or {}
            if not identity_provider:
                identity_provider = _ic.get("start_url") or None
            if not region:
                region = _ic.get("region") or None
        except Exception:
            pass  # non-fatal — will prompt if still missing

    # Method validation
    valid_methods = [m for m, _ in _BACKEND_METHODS[backend]]
    if method and method not in valid_methods:
        print(f"error: unknown method '{method}' for {backend}. "
              f"Valid methods: {', '.join(valid_methods)}", file=sys.stderr)
        return 1

    # Method menu if no --method and on a tty
    if not method:
        if not sys.stdin.isatty():
            print(f"error: --method is required when stdin is not a terminal. "
                  f"Valid methods: {', '.join(valid_methods)}", file=sys.stderr)
            return 1
        methods = _BACKEND_METHODS[backend]
        print(f"\nAvailable methods for {backend}:")
        for i, (m_name, m_desc) in enumerate(methods, 1):
            print(f"  {i}. {m_desc}")
        try:
            choice = input(f"Choose [1-{len(methods)}]: ").strip()
            idx = int(choice) - 1
            if not (0 <= idx < len(methods)):
                raise ValueError
            method = methods[idx][0]
        except (ValueError, KeyboardInterrupt, EOFError):
            print("\nerror: invalid choice", file=sys.stderr)
            return 1

    # Check current credential state and warn if replacing
    try:
        status_resp = _http_json(f"{base_url}/login/{backend}", "GET", api_key=api_key)
        if status_resp.get("configured"):
            current_method = status_resp.get("method", "unknown")
            if not yes:
                if not sys.stdin.isatty():
                    print(f"error: {backend} already has a stored credential "
                          f"(method={current_method}). Use --yes to replace it.",
                          file=sys.stderr)
                    return 1
                try:
                    confirm = input(
                        f"{backend} already has a credential (method={current_method}). "
                        f"Replace it? [y/N] "
                    ).strip().lower()
                    if confirm not in ("y", "yes"):
                        print("Aborted. Existing credential unchanged.")
                        return 0
                except (KeyboardInterrupt, EOFError):
                    print("\nAborted.")
                    return 0
    except (urllib.error.HTTPError, urllib.error.URLError):
        # If we can't reach the transport, we'll catch the error properly below
        pass

    # Paste secret methods
    if method in _PASTE_METHODS:
        # HTTPS or loopback check
        if not insecure and not _is_safe_url(base_url):
            print(
                f"error: refusing to send a secret over plain HTTP to a remote host "
                f"({base_url}). Use https:// or --insecure.",
                file=sys.stderr,
            )
            return 1
        # Read secret
        prompt = f"Enter {backend} {method}: "
        secret = _read_secret(prompt)
        if not secret:
            print("error: empty secret — nothing stored.", file=sys.stderr)
            return 1
        # POST to the transport
        try:
            resp = _http_json(
                f"{base_url}/login/{backend}/{method}", "POST",
                body={"secret": secret}, api_key=api_key,
            )
        except urllib.error.HTTPError as exc:
            try:
                body = exc.read().decode("utf-8", errors="replace").strip()
            except Exception:
                body = exc.reason
            print(f"error: transport returned HTTP {exc.code}: {body}",
                  file=sys.stderr)
            return 1
        except urllib.error.URLError as exc:
            print(f"error: could not reach transport at {base_url} — {exc.reason}",
                  file=sys.stderr)
            return 1
        stored_method = resp.get("method", method)
        print(f"Stored {backend} credential ({stored_method}).")
        return 0

    # Flow methods (device code, oauth, etc.)
    request_body: dict = {}
    if method == "identity-center":
        # Collect start_url and region — show config value as default, allow override.
        if not sys.stdin.isatty():
            # Non-interactive: require values via flag or env.
            if not identity_provider:
                print("error: --identity-provider is required for identity-center "
                      "when stdin is not a terminal.", file=sys.stderr)
                return 1
            if not region:
                print("error: --region is required for identity-center "
                      "when stdin is not a terminal.", file=sys.stderr)
                return 1
        else:
            try:
                _ip_prompt = f"IAM Identity Center start URL [{identity_provider}]: " if identity_provider else "IAM Identity Center start URL: "
                _ip_input = input(_ip_prompt).strip()
                if _ip_input:
                    identity_provider = _ip_input
                _r_prompt = f"Region [{region}]: " if region else "Region (e.g. us-east-1): "
                _r_input = input(_r_prompt).strip()
                if _r_input:
                    region = _r_input
            except (KeyboardInterrupt, EOFError):
                print("\nAborted.")
                return 1
        if not identity_provider or not region:
            print("error: start_url and region are required for identity-center.",
                  file=sys.stderr)
            return 1
        request_body = {"start_url": identity_provider, "region": region}
    elif method == "chatgpt":
        print("Note: ChatGPT device code login must be enabled in your ChatGPT "
              "account or workspace security settings.")

    # POST to start the flow
    try:
        resp = _http_json(
            f"{base_url}/login/{backend}/{method}", "POST",
            body=request_body, api_key=api_key,
        )
    except urllib.error.HTTPError as exc:
        try:
            body = exc.read().decode("utf-8", errors="replace").strip()
        except Exception:
            body = exc.reason
        if exc.code == 409:
            print("Login already in progress. Poll GET /login/{} for status.".format(backend))
            return 0
        print(f"error: transport returned HTTP {exc.code}: {body}",
              file=sys.stderr)
        return 1
    except urllib.error.URLError as exc:
        print(f"error: could not reach transport at {base_url} — {exc.reason}",
              file=sys.stderr)
        return 1

    login_url = resp.get("login_url") or resp.get("verification_url") or ""
    user_code = resp.get("user_code") or resp.get("code") or ""

    if method == "oauth":
        # Claude authorisation-code: prompt for the code after printing the URL
        print("To authenticate, open the following URL:")
        if login_url:
            print(f"  URL:  {login_url}")
        print("After approving, you will see a code to paste here.")
        # Check HTTPS or loopback before reading the code
        if not insecure and not _is_safe_url(base_url):
            print(
                f"error: refusing to send an authorisation code over plain HTTP to a "
                f"remote host ({base_url}). Use https:// or --insecure.",
                file=sys.stderr,
            )
            return 1
        try:
            code = _read_secret("Paste the authorisation code: ")
        except (KeyboardInterrupt, EOFError):
            print("\nAborted.")
            return 1
        if not code:
            print("error: empty code — nothing submitted.", file=sys.stderr)
            return 1
        # Submit the code
        try:
            _http_json(
                f"{base_url}/login/{backend}/oauth/code", "POST",
                body={"code": code}, api_key=api_key,
            )
        except urllib.error.HTTPError as exc:
            try:
                body = exc.read().decode("utf-8", errors="replace").strip()
            except Exception:
                body = exc.reason
            print(f"error: transport returned HTTP {exc.code}: {body}",
                  file=sys.stderr)
            return 1
        except urllib.error.URLError as exc:
            print(f"error: lost connection — {exc.reason}", file=sys.stderr)
            return 1
        print("Code submitted. Waiting for authentication to complete",
              end="", flush=True)
    else:
        # Device code (builder-id, identity-center, chatgpt)
        print("To authenticate, open the following URL and enter the code:")
        if login_url:
            print(f"  URL:  {login_url}")
        if user_code:
            print(f"  Code: {user_code}")
        print("Waiting for you to complete authentication", end="", flush=True)

    return _poll_flow(base_url, backend, api_key, login_url, user_code)


