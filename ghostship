def auth_status(args: list) -> int:
    """ghostship auth status [--json]"""
    base_url, api_key = _discover_transport(args)
    use_json = "--json" in args

    results = {}
    for backend in _VALID_BACKENDS:
        try:
            resp = _http_json(f"{base_url}/login/{backend}", "GET", api_key=api_key)
            results[backend] = resp
        except urllib.error.HTTPError as exc:
            try:
                body = exc.read().decode("utf-8", errors="replace").strip()
            except Exception:
                body = exc.reason
            print(f"error: transport returned HTTP {exc.code} for {backend}: {body}",
                  file=sys.stderr)
            return 1
        except urllib.error.URLError as exc:
            print(f"error: could not reach transport at {base_url} — {exc.reason}",
                  file=sys.stderr)
            return 1

    if use_json:
        print(json.dumps(results, indent=2))
        return 0

    # Table output
    print(f"{'Backend':<10}  {'Configured':<12}  {'Method':<20}  {'Stored at'}")
    print("-" * 70)
    for backend in _VALID_BACKENDS:
        info = results.get(backend, {})
        configured = "yes" if info.get("configured") else "no"
        method = info.get("method") or "not configured"
        stored_at = info.get("stored_at") or ""
        # Truncate ISO datetime for readability
        if stored_at and "T" in stored_at:
            stored_at = stored_at.split("T")[0]
        print(f"{backend:<10}  {configured:<12}  {method:<20}  {stored_at}")
    return 0


_AUTH_USAGE = """\
Usage: ghostship auth <login|logout|status> [backend] [flags]

  login <backend>    Store or replace a credential for kiro, claude or codex.
  logout <backend>   Clear the stored credential for kiro, claude or codex.
  status             Show credential status for all backends.

Backends: kiro, claude, codex

Flags (all verbs):
  --url <url>                Transport base URL
                             (default: GHOSTSHIP_URL env, then Podman inspect,
                             then http://localhost:64057)
  --api-key <key>            Bearer token (default: GHOSTSHIP_API_KEY env,
                             then ga-api-key from the data volume mount)

Flags for login:
  --method <method>          Skip method menu (methods vary by backend)
  --yes                      Replace existing credential without confirmation
  --insecure                 Allow sending secrets over plain HTTP to remote hosts
  --identity-provider <url>  IAM Identity Center start URL (kiro identity-center)
  --region <region>          AWS region (kiro identity-center)
"""

_AUTH_COMMANDS = {"login": auth_login, "logout": auth_logout, "status": auth_status}


def cmd_auth(args: list) -> int:
    if not args or args[0] in ("--help", "-h"):
        print(_AUTH_USAGE, end="")
        return 0
    sub = args[0]
    handler = _AUTH_COMMANDS.get(sub)
    if handler is None:
        print(f"error: unknown auth subcommand '{sub}'", file=sys.stderr)
        print(_AUTH_USAGE, end="", file=sys.stderr)
        return 1
    return handler(args[1:])



