_USAGE = """\
Usage: ghostship <subcommand> [flags]

Subcommands:
  install    [flags]   Install or update the transport (runs bin/install.sh)
  start      [flags]   Start the transport (runs bin/start.sh)
  stop                 Stop the transport + portal, then the Podman machine/service (frees RAM, preserves state)
  upgrade    [flags]   Rebuild and restart the transport (same as install); --skills also refreshes skill symlinks
  uninstall  [flags]   Uninstall the transport (runs bin/uninstall.sh)
  status               Show transport status
  setup      [flags]   Register MCP server + skills for agent clients (kiro, Claude Code, opencode)
  auth       [login|logout|status]  Manage backend credentials
  version              Print ghostship version

Run 'ghostship <subcommand> --help' for flags specific to that subcommand.
"""

_COMMANDS = {
    "install":   cmd_install,
    "start":     cmd_start,
    "stop":      cmd_stop,
    "upgrade":   cmd_upgrade,
    "uninstall": cmd_uninstall,
    "status":    cmd_status,
    "setup":     cmd_setup,
    "auth":      cmd_auth,
    "version":   cmd_version,
}


def main() -> int:
    args = sys.argv[1:]

    if not args or args[0] in ("--help", "-h"):
        print(_USAGE, end="")
        return 0

    subcmd = args[0]
    if subcmd in ("--version", "-V"):
        return cmd_version([])

    handler = _COMMANDS.get(subcmd)
    if handler is None:
        print(f"error: unknown subcommand '{subcmd}'", file=sys.stderr)
        print(f"Run 'ghostship --help' for available subcommands.", file=sys.stderr)
        return 1

    return handler(args[1:]) or 0


if __name__ == "__main__":
    sys.exit(main())
