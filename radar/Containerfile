# Stage 1 compiles the Radar SPA. The Node image is Node 24 LTS, pinned by the
# index digest of node:24-alpine. No tests run here: a flaky test must not fail
# an install or upgrade. Type errors and build errors do fail the image.
FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS web-build

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY web/ ./
RUN npm run typecheck && npm run build

# Stage 2 is the runtime image. It gets the built output only: no Node, no
# node_modules and no frontend source.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY server.py ./
COPY --from=web-build /web/dist/ ./static/

EXPOSE 8080

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8080"]
