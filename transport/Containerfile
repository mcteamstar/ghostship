FROM python:3.12.10-slim

WORKDIR /app

# Install dependencies first (layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy transport package (all modules)
COPY . /app/
# Exclude crew-side scripts (those belong in the crew image via admission layer)
RUN rm -rf /app/container_scripts/

# Version baked in at build time via --build-arg VERSION=<semver>
ARG VERSION=0.0.0-dev
ENV TRANSPORT_VERSION=${VERSION}
ARG SOURCE_HASH=unknown
LABEL org.ghostship.source-hash=${SOURCE_HASH}

EXPOSE 64057 64058

CMD ["python", "server.py"]
