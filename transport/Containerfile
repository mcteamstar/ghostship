FROM python:3.12.10-slim

WORKDIR /app

# Install dependencies first (layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy server
COPY server.py security.py config.py ./

# Container-side helper scripts, baked into the image at /scripts/.
# server.py invokes these via `podman exec ... python3 /scripts/<name>.py`
# instead of building inline `python3 -c "..."` strings. See TRN-74.
# Use *.py glob so local __pycache__/ is never included in the image layer.
COPY container_scripts/*.py /scripts/

# Version baked in at build time via --build-arg VERSION=<semver>
ARG VERSION=0.0.0-dev
ENV TRANSPORT_VERSION=${VERSION}

EXPOSE 64057 64058

CMD ["python", "server.py"]
